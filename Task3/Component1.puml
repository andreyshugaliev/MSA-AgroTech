@startuml
title AgroTech Control Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(AgroTechSystem, "AgroTech Control Component") {
  Container(Control, "Сервис управления", "", "Управляет кормушками и поилками")
  Container(Database, "Database", "PostgreSQL", "Хранит данные")
}

Container(Control, "Сервис управления", "") {
  Component(SensorController, "SensorController", "Получает данные с разных датчиков")
  Component(DeviceController, "DeviceController", "Управляет кормушками и поилками")
  Component(StorageController, "StorageController", "анализирует запасы на складе")
  Component(ServiceLayer, "Engine Layer", "Реализует логику работы")
  Component(RepositoryLayer, "Repository Layer", "Соединяется с БД")
}

Rel(SensorController,ServiceLayer,"Передаёт данные")
Rel(DeviceController,ServiceLayer,"Принимает команды")
Rel(StorageController,ServiceLayer,"Составляет прогнозы")
Rel(ServiceLayer,RepositoryLayer,"Пишет/читает данные")
Rel(RepositoryLayer,Database,"Пишет/читает данные")
@enduml