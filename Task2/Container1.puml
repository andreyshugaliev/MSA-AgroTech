@startuml
title AgroTech Container Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

System_Ext(edge, "Датчики", "Датчики воды и корма")
System_Ext(cctv, "Камеры", "Камеры в помещениях")
System_Ext(recogAI, "Внешняя нейросетевая модель", "Внешняя нейросетевая модель для распознавания и подсчётов")

System(AgroTechSystem, "AgroTech System", "Система анализа, контроля и уведомления")
Container_Boundary(AgroTechSystem, "AgroTech System") {
  Container(control, "Сервис управления", "", "Управляет кормушками и поилками")
  Container(analysis, "Сервис анализа данных от камер", "", "Обрабатывает данные от нейросети")
  Container(alarm, "Система оповещения", "", "Рассылает оповещения пользователям")
  Container(Database, "Database", "PostgreSQL", "Хранит все данные")
  Container(API, "API", "", "API для связи с системой")
}
Person(watch, "Дежурный", "Дежурный по комплексу")
System_Ext(extConsumers, "Внешние потребители", "Мобильные и веб приложения")
System_Ext(mainframe, "Центральное БД", "Центральное хранилище данных")
System_Ext(feeder, "Кормушки и поилки", "Кормушки и поилки для скота")


Rel(edge, control, "Передаёт данные")
Rel(control, Database, "Хранит показания датчиков")
Rel(Database, control, "Берёт данные по скоту и остаткам на складе")
Rel(cctv,recogAI,"Передаёт видеопоток")
Rel(recogAI,analysis,"Передаёт данные")
Rel(analysis, alarm, "Отдаёт команды на оповещение в случае ЧП")
Rel(analysis, Database, "Хранит результаты анализов")
Rel(Database, API, "Обменивается данными")
Rel(alarm,watch,"Рассылает оповещения")
Rel(control, feeder, "Отдаёт команды")
Rel(API,extConsumers,"Передаёт данные вовне")
Rel(API,mainframe,"Синхронизирует данные")

@enduml